# ==============================================================================
# KrushikaDhara — Frontend Environment Configuration
# Copy this file to .env and set your LAN IP address.
# EXPO_PUBLIC_* variables are bundled at build time.
# ==============================================================================

# Run `ipconfig` (Windows) or `ifconfig` (Mac/Linux) to find your WiFi IPv4 address.
# Make sure your phone and development computer are on the same WiFi network.
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:5000/api

