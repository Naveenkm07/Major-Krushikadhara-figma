# ==============================================================================
# KrushikaDhara Backend Environment Variables Example
# Copy this file to .env and insert your real API keys before starting the server.
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# 1. Neon Cloud PostgreSQL Connection String
DATABASE_URL="postgresql://username:password@ep-sample-neon.region.aws.neon.tech/krushikadhara?sslmode=require"

# 2. JWT Authentication Secret
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="30d"

# 3. Twilio SMS Configuration (Optional for mobile OTP verification)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# 4. Cloudinary (For storing crop leaf scan photos & equipment images)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 5. Sarvam AI (Indian Languages Speech-to-Text: Kannada, etc.)
SARVAM_API_KEY="your_sarvam_api_key"

# 6. Real-time Weather API (WeatherAPI.com)
WEATHER_API_KEY="your_weatherapi_key"

# 7. Official Government Mandi Price API (data.gov.in / AGMARKNET)
MANDI_API_KEY="your_data_gov_in_api_key"
DATA_GOV_IN_API_KEY="your_data_gov_in_api_key"
DATA_GOV_IN_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"
GEOCODING_CONTACT="your_email@domain.com"

# 8. Google Gemini AI API Key (Free Tier for Agricultural Advisory)
GEMINI_API_KEY="your_gemini_api_key"
