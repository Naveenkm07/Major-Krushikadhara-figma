generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. Farmer Profile & Authentication
// ==============================================================================
model Farmer {
  id                String   @id @default(uuid())
  mobile            String   @unique
  name              String?  @default("Farmer")
  state             String   @default("Karnataka")
  district          String   @default("Mandya")
  taluk             String?
  village           String?
  latitude          Float?
  longitude         Float?
  farmSize          Float    @default(2.5) // In acres
  experienceYears   Int      @default(5)
  photoUrl          String?
  preferredLanguage String   @default("kn") // "kn" for Kannada, "en" for English
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  activeCrops       CropField[]
  equipmentListed   Equipment[]
  rentalsRequested  RentalBooking[]      @relation("RenterBookings")
  scans             CropScan[]
  interactions      FarmerInteraction[]

  @@index([mobile])
  @@index([district, taluk])
}

// Temporary OTP verification tokens via Twilio
model OtpToken {
  id        String   @id @default(uuid())
  mobile    String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile, verified])
}

// ==============================================================================
// 2. CORE APP FEATURE: Crop Present Growth Stage & Tailored Advisories
// ==============================================================================
// Tracks the exact present stage of the farmer's crop to provide tailored daily guidance
model CropField {
  id                    String   @id @default(uuid())
  farmerId              String
  farmer                Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName              String   // e.g. "Rice (Paddy)", "Ragi", "Tomato", "Chilli"
  variety               String?  // e.g. "Sona Masoori", "BPT 5204", "Hybrid 1008"
  sowingDate            DateTime
  expectedHarvestDate   DateTime?
  
  // Present Crop Stage
  currentStage          String   // e.g. "SOWING", "VEGETATIVE", "TILLERING", "PANICLE_INITIATION", "FLOWERING", "FRUIT_FORMATION", "RIPENING", "HARVEST"
  stageDayCount         Int      @default(1)
  
  // Real-time Health & Farmer Feedback
  healthStatus          String   @default("HEALTHY") // "HEALTHY", "PEST_SUSPECTED", "DISEASED", "WATER_STRESSED", "NUTRIENT_DEFICIENT"
  latestFarmerNote      String?  // Current farmer observation entered via Voice (Sarvam STT) or text
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Historical interaction & stage logs
  interactions          FarmerInteraction[]
  advisories            StageAdvisory[]

  @@index([farmerId])
}

// Stage-specific tailored suggestions generated for the farmer's current stage
model StageAdvisory {
  id             String    @id @default(uuid())
  cropFieldId    String
  cropField      CropField @relation(fields: [cropFieldId], references: [id], onDelete: Cascade)
  stageName      String    // The stage this advisory applies to
  
  category       String    // "IRRIGATION", "FERTILIZER", "PEST_PREVENTION", "WEATHER_ALERT", "HARVEST_READY"
  titleEn        String
  titleKn        String    // Kannada title
  bodyEn         String
  bodyKn         String    // Kannada body
  urgency        String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  
  isApplied      Boolean   @default(false) // Whether farmer confirmed following this step
  createdAt      DateTime  @default(now())

  @@index([cropFieldId, stageName])
}

// Log of farmer inputs (Speech-to-Text via Sarvam AI or Typed Text)
model FarmerInteraction {
  id             String     @id @default(uuid())
  farmerId       String
  farmer         Farmer     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropFieldId    String?
  cropField      CropField? @relation(fields: [cropFieldId], references: [id], onDelete: SetNull)
  
  inputType      String     @default("VOICE") // "VOICE" or "TEXT"
  language       String     @default("kn")    // "kn" (Kannada) or "en"
  audioUrl       String?    // Cloudinary audio recording URL if voice
  transcriptText String     // Transcript generated by Sarvam STT
  aiResponseText String     // Tailored agronomist answer based on present stage & weather
  
  createdAt      DateTime   @default(now())

  @@index([farmerId])
}

// ==============================================================================
// 3. Equipment Rental Marketplace (Farmers renting to other farmers)
// ==============================================================================
model Equipment {
  id           String          @id @default(uuid())
  ownerId      String
  owner        Farmer          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  name         String          // e.g. "Mahindra 575 DI Tractor", "Fieldking Rotavator 6ft"
  type         String          // "Tractor", "Rotavator", "Seed Drill", "Sprayer", "Harvester", "Cultivator"
  location     String          // e.g. "Pandavapura, Mandya"
  latitude     Float?
  longitude    Float?
  pricePerDay  Float
  availability String          @default("AVAILABLE") // "AVAILABLE", "BOOKED", "MAINTENANCE"
  
  hp           String?         @default("45 HP")
  fuel         String?         @default("Diesel")
  condition    String?         @default("Good")
  minDuration  String?         @default("1 day")
  imageUrl     String          // Cloudinary image URL of the machine
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  bookings     RentalBooking[]

  @@index([ownerId])
  @@index([location, type])
}

model RentalBooking {
  id            String    @id @default(uuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  renterId      String
  renter        Farmer    @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  pricePerDay   Float
  totalAmount   Float
  status        String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "ACTIVE", "COMPLETED", "CANCELLED"
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([equipmentId])
  @@index([renterId])
}

// ==============================================================================
// 4. AI Crop Scan & Pathology (TFLite diagnosis + Cloudinary image backup)
// ==============================================================================
model CropScan {
  id             String   @id @default(uuid())
  farmerId       String
  farmer         Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  
  cropName       String   // e.g. "Tomato", "Paddy", "Chilli"
  diseaseName    String   // e.g. "Early Blight", "Healthy Crop", "Leaf Curl Virus"
  scientificName String?  // e.g. "Alternaria solani"
  confidence     Float    // e.g. 94.2
  severity       String   // "Low", "Moderate", "High", "Critical"
  imageUrl       String   // Cloudinary secure URL
  
  // Stored remedies for this diagnosis
  remediesJson   Json?    // Organic, Chemical, and Prevention remedy arrays
  
  createdAt      DateTime @default(now())

  @@index([farmerId])
}

// ==============================================================================
// 5. Nearest Mandi Market Rates & Directory
// ==============================================================================
model Mandi {
  id             BigInt   @id @default(autoincrement())
  name           String   @db.VarChar(255)
  state          String   @db.VarChar(100)
  district       String?  @db.VarChar(150)
  latitude       Float
  longitude      Float
  locationSource String?  @map("location_source")
  isVerified     Boolean  @default(false) @map("is_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mandis")
  @@index([state])
  @@index([district])
  @@index([latitude, longitude])
}

model MandiPrice {
  id            String   @id @default(uuid())
  commodity     String   // e.g. "Tomato", "Ragi", "Paddy(Dhan)", "Onion"
  marketName    String   // e.g. "Mandya APMC", "Mysuru APMC", "Maddur"
  district      String   // e.g. "Mandya"
  state         String   @default("Karnataka")
  latitude      Float?
  longitude     Float?
  
  minPrice      Float    // Price per Quintal (or /kg)
  maxPrice      Float
  modalPrice    Float    // Wholesale ruling market rate
  priceDate     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([commodity, district])
  @@index([marketName])
}

